{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: 调试当前打开的文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": true
        }
    ]
}